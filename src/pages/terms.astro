---
import Page from '../layouts/Page.astro';

const title = 'Terms of Service — Culprit';
const description =
  'Culprit’s full terms of service publish here before launch, including the veterinary-care disclaimer. Questions: support@getculprit.app.';
---

<Page
  title={title}
  heading="Terms of Service"
  description={description}
  index={false}
  updated="Draft in progress — the full terms publish here before Culprit launches."
>
  <p>
    Our full terms of service are being finalized and will be published on this
    page before Culprit is available to download. They&rsquo;ll cover the
    everyday basics: acceptable use, the limits of the service, and the
    veterinary-care disclaimer below.
  </p>

  <h2>A note worth saying now</h2>
  <p>
    Culprit helps you track and share information about your pet&rsquo;s health.
    It is not a medical device, and it does not provide veterinary advice,
    diagnosis, or treatment. It doesn&rsquo;t replace a visit to your vet —
    always rely on your veterinarian for care decisions. If you think your pet
    needs attention, contact your vet.
  </p>

  <h2>Questions in the meantime</h2>
  <p>
    Email <a href="mailto:support@getculprit.app">support@getculprit.app</a> and
    we&rsquo;ll help.
  </p>
</Page>
