---
// The hero's bezel-less home-screen recreation (ValuePreview discipline:
// recreated UI, never a doctored screenshot — nothing shown that the product
// doesn't render). The bottom fade mask lets it sink into the night ground.
// All recreated-UI copy lives here as named constants for nyx-voice review:
// Signal copy stays descriptive (never causal) and always carries its sample.
import SignalCard from './SignalCard.astro';
import TodayRows from './TodayRows.astro';

const PET_NAME = 'Mochi';
const PET_META = '212 events · 6 weeks logged';

const SIGNAL_HEADLINE = 'Vomiting is down 60% over the last two weeks.';
const SIGNAL_BADGE = 'Improving';
const SIGNAL_SAMPLE = '6 episodes → 2 · 14 days';
const SIGNAL_SPARK = {
  d: 'M4 8 L44 14 L84 12 L124 24 L164 30 L212 34',
  cx: 212,
  cy: 34,
};

const TODAY_ROWS = [
  {
    kind: 'meal',
    title: 'Meal',
    detail: 'Hydrolyzed protein · full bowl',
    time: '8:05 AM',
  },
  {
    kind: 'symptom',
    title: 'Vomit',
    detail: 'Photo attached',
    time: '2:14 PM',
  },
] as const;
---

<div
  class="app-card"
  role="img"
  aria-label="Preview of the Culprit home screen: a Signal insight above today's log."
>
  <div class="app-card__pet"><b>{PET_NAME}</b><span>{PET_META}</span></div>
  <div class="ui-label app-card__label">Signal</div>
  <SignalCard
    headline={SIGNAL_HEADLINE}
    badge={SIGNAL_BADGE}
    sample={SIGNAL_SAMPLE}
    spark={SIGNAL_SPARK}
  />
  <div class="ui-label app-card__label app-card__label--today">Today</div>
  <TodayRows rows={TODAY_ROWS} />
</div>

<style>
  .app-card {
    background: var(--paper);
    color: var(--text-primary);
    border-radius: 34px 34px 0 0;
    box-shadow:
      0 -1px 0 rgba(242, 238, 228, 0.14),
      0 32px 90px -20px rgba(0, 0, 0, 0.6);
    padding: 26px 20px 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 74%, transparent 99%);
    mask-image: linear-gradient(to bottom, #000 74%, transparent 99%);
  }
  .app-card__pet {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 12px;
  }
  .app-card__pet b {
    font-size: 1.4375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .app-card__pet span {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }
  .app-card__label {
    margin-bottom: 7px;
  }
  .app-card__label--today {
    margin-top: 14px;
  }
</style>
