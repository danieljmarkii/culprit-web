---
// Sparse night-sky stars (the F-element the v2 spec keeps — ambience only).
// Positions and twinkle timing come from a seeded PRNG at build time, so the
// sky is deterministic across builds: no runtime random, no hydration, no CLS.
// Twinkle is pure CSS and off under prefers-reduced-motion (stars stay lit).
interface Props {
  /** Star count — the hero uses ~12; keep it sparse. */
  count?: number;
  /** Change to re-scatter (e.g. a different band of the same sky). */
  seed?: number;
  class?: string;
}
const { count = 12, seed = 1913, class: className = '' } = Astro.props;

// mulberry32 — tiny seeded PRNG, plenty for scatter.
function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(seed);
const stars = Array.from({ length: count }, () => ({
  x: (3 + rand() * 94).toFixed(2),
  y: (4 + rand() * 88).toFixed(2),
  size: (1 + rand() * 1.5).toFixed(2),
  base: (0.3 + rand() * 0.45).toFixed(2),
  delay: (rand() * 6).toFixed(2),
  dur: (2.8 + rand() * 3.2).toFixed(2),
}));
---

<div class={`starfield ${className}`} aria-hidden="true">
  {
    stars.map((s) => (
      <i
        style={`left:${s.x}%;top:${s.y}%;width:${s.size}px;height:${s.size}px;--star-base:${s.base};--star-delay:${s.delay}s;--star-dur:${s.dur}s`}
      />
    ))
  }
</div>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .starfield i {
    position: absolute;
    border-radius: 50%;
    background: var(--moonlight);
    opacity: var(--star-base);
    animation: twinkle var(--star-dur) ease-in-out var(--star-delay) infinite
      alternate;
  }
  @keyframes twinkle {
    from {
      opacity: calc(var(--star-base) * 0.3);
    }
    to {
      opacity: var(--star-base);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starfield i {
      animation: none;
    }
  }
</style>
