# Cloudflare Pages headers. https://developers.cloudflare.com/pages/configuration/headers/
# The site is static and ships zero JS; CSP is locked down accordingly.
# ('unsafe-inline' for styles covers Astro's scoped <style> blocks — there are
# no inline scripts.)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'

# Hashed, immutable build assets can be cached hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
